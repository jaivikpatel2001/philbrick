# =============================================================================
# PHILBRICK static site — Apache / cPanel configuration
#
# Ships inside the export (out/) so uploading the folder to public_html "just
# works". Render and other CDN hosts ignore this file — their equivalents live
# in ../render.yaml.
#
# WHY THIS FILE CARRIES THE COMPRESSION AND CACHING RULES
# The site is a Next.js static export (`output: "export"`). Next's own
# `compress` option only applies to `next start` / a custom Node server, and
# `headers()` is explicitly unsupported for a static export — there is no
# Next.js process in production to emit response headers. Gzip/Brotli and
# Expires/Cache-Control are therefore 100% the web server's job, i.e. this file.
#
# Modules used (all standard on cPanel/WHM): mod_rewrite, mod_deflate,
# mod_brotli, mod_expires, mod_headers, mod_mime. Every block is wrapped in
# <IfModule> so a host missing one degrades instead of throwing a 500.
# =============================================================================

# No directory listings; no content-negotiation surprises
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # --- Launch hardening (enable after the final domain + SSL are live): ---
  # Force HTTPS and the canonical www host so served URLs match SITE.url.
  # Replace example.com with the real domain, then remove the leading #s.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.example.com%{REQUEST_URI} [R=301,L]

  # Trim trailing slashes so /about/ resolves like /about
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Clean URLs: if the request isn't a real file, serve its .html twin
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# Branded 404 (exported by Next as /404.html)
ErrorDocument 404 /404.html

# =============================================================================
# MIME TYPES
# Older cPanel mime.types files predate several of these. A type Apache does not
# know is served as application/octet-stream, which silently skips BOTH the
# compression filter (matched by type) and the Expires rules (matched by type).
# Declaring them here is what makes the two sections below actually fire.
# =============================================================================
<IfModule mod_mime.c>
  AddType text/javascript                 .js .mjs
  AddType application/json                .json
  AddType application/manifest+json       .webmanifest
  AddType image/svg+xml                   .svg .svgz
  AddType image/webp                      .webp
  AddType image/avif                      .avif
  AddType image/x-icon                    .ico
  AddType font/woff                       .woff
  AddType font/woff2                      .woff2
  AddType application/rss+xml             .rss
  AddType application/atom+xml            .atom
  # Next.js App Router RSC payloads for client-side navigation
  AddType text/plain                      .txt
</IfModule>

# =============================================================================
# COMPRESSION  (Pingdom: "Compress components with gzip")
#
# Brotli first when the browser advertises it, gzip for everyone else. Pingdom
# and the older GTmetrix/YSlow rules look specifically for a gzip
# Content-Encoding, so mod_deflate must stay enabled even where mod_brotli is
# available — do not remove it in favour of Brotli alone.
#
# Only text formats are listed. Images (webp/png/jpg/avif/gif), woff2 fonts and
# .ico are already compressed; running them through DEFLATE burns CPU and can
# make the response marginally LARGER.
# =============================================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS application/xml application/xhtml+xml
  AddOutputFilterByType BROTLI_COMPRESS application/rss+xml application/atom+xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  # text/javascript is the type Apache 2.4 assigns to .js — the previous rule
  # listed only application/javascript, so NONE of the Next.js bundles were
  # being gzipped. Both are listed now.
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf font/otf application/vnd.ms-fontobject

  # Never re-compress already-compressed payloads
  <IfModule mod_setenvif.c>
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|bz2|rar|7z|mp4|webm|woff2?)$ no-gzip dont-vary
  </IfModule>

  # Ancient-browser guards kept from Apache's recommended config
  <IfModule mod_setenvif.c>
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE\s7 !no-gzip !gzip-only-text/html
  </IfModule>

  # Proxies must key their cache on the encoding
  <IfModule mod_headers.c>
    Header append Vary Accept-Encoding env=!dont-vary
  </IfModule>
</IfModule>

# =============================================================================
# EXPIRES HEADERS  (Pingdom: "Add Expires headers")
#
# Pingdom / YSlow grade on the presence of a far-future `Expires` header, not
# only `Cache-Control: max-age`. mod_expires emits `Expires`; the mod_headers
# block below adds the matching `Cache-Control` (including `immutable`, which
# mod_expires cannot express). Both are needed — keep them in sync.
# =============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  # HTML and the RSC navigation payloads must always revalidate, otherwise a
  # deploy is invisible to anyone who already loaded the site.
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/plain                "access plus 0 seconds"
  ExpiresByType application/xml           "access plus 0 seconds"
  ExpiresByType application/rss+xml       "access plus 0 seconds"
  ExpiresByType application/atom+xml      "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"

  # Build output: content-hashed filenames, so the URL changes when the bytes do
  ExpiresByType text/javascript           "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"

  # Self-hosted fonts (next/font writes hashed .woff2 into /_next/static/media)
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType font/ttf                  "access plus 1 year"
  ExpiresByType font/otf                  "access plus 1 year"

  # Brand photography and icons: stable names but they CAN change on redeploy,
  # so a month (matching the project caching rule + render.yaml), not a year.
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/avif                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/gif                 "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType image/x-icon              "access plus 1 month"

  # Video, if any is ever added under /videos
  ExpiresByType video/mp4                 "access plus 1 month"
  ExpiresByType video/webm                "access plus 1 month"
</IfModule>

# =============================================================================
# CACHE-CONTROL
# mod_expires cannot express `immutable`, so the exact directive is set here.
# Every .js and .css the site serves is build output under /_next/static/ and
# carries a content hash in its filename, so a year + immutable is safe: a new
# build produces new URLs and the old ones are simply never requested again.
# =============================================================================
<IfModule mod_headers.c>
  # --- Content-hashed build output: never revalidate -------------------------
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- Fonts: hashed by next/font, safe to pin for a year --------------------
  <FilesMatch "\.(woff2?|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # --- Brand photography, icons, video: one month (see render.yaml) ----------
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # --- HTML, RSC payloads, sitemap/robots: always revalidate -----------------
  # Listed LAST so it overrides anything above for these extensions.
  <FilesMatch "\.(html|txt|xml|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
    Header unset Expires
    Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
  </FilesMatch>

  # --- Security + correctness -----------------------------------------------
  Header set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # next/font woff2 are same-origin but Next emits crossorigin on the preload,
  # which turns the request into CORS mode; without this the font is refetched.
  <FilesMatch "\.(woff2?|ttf|otf)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>

# YSlow/Pingdom "Configure entity tags": with far-future Expires + hashed URLs
# an ETag adds a header to every response and buys nothing.
<IfModule mod_headers.c>
  Header unset ETag
</IfModule>
FileETag None
